#!/usr/bin/bash
#
# Installs brew, git, nvim, tmux, bat, fzf, fd, broot.

script_dir="$(cd "$(dirname "$0")" && pwd)"
root_dir="$(cd "$(dirname "$script_dir")" && pwd)"

cp $root_dir/.inputrc $HOME
cp $root_dir

# Install homebrew
curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh

brew install git # install the most recent version
brew install nvim
brew install tmux
brew install bat
brew install fzf
brew install fd
brew install broot
