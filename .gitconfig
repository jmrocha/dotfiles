[core]
	editor = nvim
	quotepath = false
	autocrlf = input
	pager = less
[push]
	default = simple
[gpg]
	program = gpg
[help]
	autocorrect = 1
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = João M. Rocha
	email = rocha.jmiguel@gmail.com
[init]
	defaultBranch = master
